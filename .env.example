# Copy to .env and replace every value marked "replace-with". Never commit .env.
DOWNLOADARR_USERNAME=downloadarr
DOWNLOADARR_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
TORBOX_API_TOKEN=replace-with-your-torbox-api-token
DOWNLOADARR_SONARR_URL=http://sonarr:8989
DOWNLOADARR_SONARR_API_KEY=replace-with-your-sonarr-api-key
DOWNLOADARR_SONARR_CATEGORY=tv-sonarr
DOWNLOADARR_RADARR_URL=http://radarr:7878
DOWNLOADARR_RADARR_API_KEY=replace-with-your-radarr-api-key
DOWNLOADARR_RADARR_CATEGORY=radarr
DOWNLOADARR_MAX_JOB_FAILURES=5
DOWNLOADARR_MINIMUM_FILE_SIZE_MB=0
DOWNLOADARR_TELEMETRY_RETENTION_DAYS=0
DOWNLOADARR_EXPORT_MAX_ROWS=5000
