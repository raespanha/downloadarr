{
  "schema_version": 1,
  "database": {
    "url": "sqlite+aiosqlite:////config/downloadarr.db"
  },
  "download": {
    "path": "/downloads",
    "connections": 8,
    "provider_max_connections": 4,
    "minimum_file_size_mb": 0,
    "transfer_mode": "auto",
    "categories": {
      "tv-sonarr": "/downloads/tv-sonarr",
      "radarr": "/downloads/radarr"
    }
  },
  "qbittorrent": {
    "username": "downloadarr",
    "password": "replace-with-a-strong-password",
    "api_key": null,
    "webapi_version": "2.8.1",
    "application_version": "v4.3.9"
  },
  "torbox": {
    "api_token": "replace-with-your-torbox-token",
    "api_base": "https://api.torbox.app/v1/api",
    "request_timeout": 30
  },
  "integrations": {
    "sonarr": {
      "url": "http://sonarr:8989",
      "api_key": "replace-with-your-sonarr-api-key",
      "category": "tv-sonarr"
    },
    "radarr": {
      "url": "http://radarr:7878",
      "api_key": "replace-with-your-radarr-api-key",
      "category": "radarr"
    }
  },
  "scheduler": {
    "provider_concurrency": 4,
    "poll_interval": 5,
    "queued_poll_interval": 30,
    "max_poll_backoff": 300,
    "max_job_failures": 5
  },
  "telemetry": {
    "retention_days": 0,
    "export_max_rows": 5000
  }
}
